    "/api/v1/posts/{id}/publish": {
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "Publish a post.",
        "description": "Publishing an already-published post is a no-op. `Depends<Editor>` is the\nauthorisation rule: a caller without `x-role: editor` never reaches the\nbody, and gets a 403 with the message the dependency declares.",
        "operationId": "posts_publish",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`PostOut`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostOut"
                }
              }
            }
          },
          "401": {
            "description": "The `x-api-key` header is absent or not a valid key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "only an editor may publish a post",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
