  "components": {
    "schemas": {
      "CreatePost": {
        "type": "object",
        "description": "A post, as the API accepts one.",
        "properties": {
          "title": {
            "type": "string",
            "description": "Headline, shown in listings.\n\nThe value is trimmed of leading and trailing whitespace when it is received.",
            "minLength": 3,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "description": "The body, in CommonMark.",
            "minLength": 1,
            "maxLength": 100000
          },
          "publish": {
            "type": "boolean",
            "description": "Publish immediately instead of saving a draft.",
            "default": false
          }
        },
        "required": [
          "title",
          "body"
        ]
      },
      "Page_PostOut": {
        "type": "object",
        "description": "One page of results, in Moso's standard pagination envelope.",
        "properties": {
          "items": {
            "type": "array",
            "description": "The rows, in the order the query produced them.",
            "items": {
              "$ref": "#/components/schemas/PostOut"
            }
          },
          "next_cursor": {
            "type": "string",
            "format": "cursor",
            "description": "Pass back as `cursor` to fetch the next page. Absent on the last page.",
            "maxLength": 2048,
            "contentEncoding": "base64url"
          },
          "prev_cursor": {
            "type": "string",
            "format": "cursor",
            "description": "Pass back as `cursor` to fetch the previous page. Absent on the first.",
            "maxLength": 2048,
            "contentEncoding": "base64url"
          },
          "total": {
            "type": "integer",
            "description": "The number of matching rows. Present only when the request asked for a count, because counting is a second query.",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "description": "The 1-based page number this is. Present only on an offset-paginated listing, which is also the one that carries no cursors.",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "description": "The page size the listing was asked for. With `total` it gives the page count.",
            "minimum": 1
          }
        },
        "required": [
          "items"
        ]
      },
      "PostOut": {
        "type": "object",
        "description": "A post, as the API returns one.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key."
          },
          "slug": {
            "type": "string",
            "format": "slug",
            "description": "The URL-safe name.",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "description": "Headline."
          },
          "body": {
            "type": "string",
            "description": "The body, in CommonMark."
          },
          "author": {
            "type": "string",
            "description": "Who wrote it."
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it went public, or `null` while it is a draft."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was created."
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "body",
          "author",
          "created_at"
        ]
      },
      "Problem": {
        "type": "object",
        "title": "Problem",
        "description": "An RFC 9457 problem document. Every Moso error is serialised in this shape, as `application/problem+json`.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "A URI identifying the problem *class*. Dereferenceable documentation; defaults to `https://moso.rs/errors/{kind}`.",
            "default": "about:blank",
            "examples": [
              "https://moso.rs/errors/validation"
            ]
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem class.",
            "examples": [
              "Validation failed"
            ]
          },
