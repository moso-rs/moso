      "delete": {
        "tags": [
          "posts"
        ],
        "summary": "Delete a post.",
        "description": "Only the author or an editor may delete. Deleting twice is a 404 the second\ntime: the client asked to remove something that was not there.",
        "operationId": "posts_destroy",
        "parameters": [
