{
  "openapi": "3.1.1",
  "info": {
    "title": "Moso blog API",
    "description": "The Moso tutorial application. Posts live in SQLite through Moso's own ORM; the example creates a fresh database on every start.",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "this instance"
    }
  ],
  "paths": {
    "/api/v1/posts": {
      "get": {
        "tags": [
          "posts"
        ],
        "summary": "List posts.",
        "description": "Published posts, newest first. Name yourself with `x-author` to see your own\ndrafts as well; an editor may ask for every draft with `?drafts=true`.\nResults are cursor-paginated: pass the previous page's `next_cursor` back as\n`?cursor=`.",
        "operationId": "posts_list",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive substring match over the title.\n\nThe value is trimmed of leading and trailing whitespace when it is received.",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "description": "Case-insensitive substring match over the title.\n\nThe value is trimmed of leading and trailing whitespace when it is received.",
              "maxLength": 100
            }
          },
          {
            "name": "drafts",
            "in": "query",
            "description": "Include drafts. Honoured only for an editor; ignored otherwise.",
            "schema": {
              "type": "boolean",
              "description": "Include drafts. Honoured only for an editor; ignored otherwise.",
              "default": false
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The `next_cursor` of the previous page.",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "cursor",
              "description": "The `next_cursor` of the previous page.",
              "maxLength": 2048,
              "contentEncoding": "base64url"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many posts to return. Defaults to the configured `posts.page_size`.",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "description": "How many posts to return. Defaults to the configured `posts.page_size`.",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`Page_PostOut`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_PostOut"
                }
              }
            }
          },
          "404": {
            "description": "No post with id {id}",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The slug `{slug}` is already taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Provide at least one field to change; The title must contain at least one letter or digit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unhandled failure. The `detail` is suppressed unless `http.expose_internal_errors` is set; the `request_id` identifies the occurrence in the server log.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The server is draining for shutdown, or a hard dependency is unavailable. Retryable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "Create a post.",
        "description": "The slug is derived from the title and suffixed if it collides, so two posts\ncalled \"Hello\" become `hello` and `hello-2`. Requires the API key.",
        "operationId": "posts_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePost"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "`PostOut`",
            "headers": {
              "location": {
                "description": "Where the created resource can be fetched.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference",
                  "examples": [
                    "/users/42"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostOut"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, or nesting past `http.json_depth_max`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The `x-api-key` header is absent or not a valid key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No post with id {id}",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The slug `{slug}` is already taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The body exceeded `http.body_max`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "The `Content-Type` is not JSON",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`CreatePost` failed validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unhandled failure. The `detail` is suppressed unless `http.expose_internal_errors` is set; the `request_id` identifies the occurrence in the server log.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The server is draining for shutdown, or a hard dependency is unavailable. Retryable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
